# API Keys for different language models
# Uncomment and add your keys for the models you want to use

# OpenAI - required for GPT models (gpt-4o, gpt-4-turbo, etc.)
# OPENAI_API_KEY=your_openai_key_here

# Anthropic - required for Claude models
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Azure OpenAI - required for Azure-hosted OpenAI models
# AZURE_OPENAI_ENDPOINT=your_azure_endpoint_here
# AZURE_OPENAI_KEY=your_azure_key_here

# Google - required for Gemini models
# GEMINI_API_KEY=your_gemini_key_here

# Other model providers
# DEEPSEEK_API_KEY=your_deepseek_key_here
# GROK_API_KEY=your_grok_key_here
# NOVITA_API_KEY=your_novita_key_here

# Browser Use configuration
# BROWSER_USE_HEADLESS=false  # Set to true to run browser in headless mode
# BROWSER_USE_SLOW_MO=100     # Delay in milliseconds between actions 